# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (see getUpdates); the bot answers only to this chat
TELEGRAM_CHAT_ID=
# Google AI Studio API key
GEMINI_API_KEY=
# Gemini models: explicit ids only (no *-latest). Fallback is used when the main model's RPD is spent.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Our limits per model, ~50 % of the free tier (15 RPM, 250K TPM, 500 RPD per model in AI Studio)
GEMINI_RPM=7
GEMINI_RPD=250
GEMINI_TPM=120000
# Daily quota resets at midnight in this zone (Pacific Time = ~09:00 in Prague)
GEMINI_QUOTA_TZ=America/Los_Angeles

# Optional overrides
# DB_PATH=data/scanner.db
# CONFIG_PATH=config.yaml
# LOG_LEVEL=INFO
